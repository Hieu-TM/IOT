AQUA_SCOPE_DB_USER=sa
AQUA_SCOPE_DB_PASSWORD=YourStrong!Passw0rd
AQUA_SCOPE_SESSION_SECRET=replace-with-a-long-random-secret
AQUA_SCOPE_ADMIN_USERNAME=admin
AQUA_SCOPE_ADMIN_PASSWORD=replace-with-a-strong-password
# Optional: override the entire connection string instead of user/password above.
# AQUA_SCOPE_DATABASE_URL=mssql+pyodbc://sa:YourPass@localhost\SQLEXPRESS/AquaScope?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes
# Set true when the application is served by HTTPS.
AQUA_SCOPE_COOKIE_SECURE=false

# Ingest token security for POST /api/ingest
AQUA_SCOPE_INGEST_TOKEN=replace-with-a-secure-token

